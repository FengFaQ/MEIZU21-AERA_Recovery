// Direct recovery-core host for AERA UI. No XML page engine is linked.
cc_library_static {
    name: "libaera_recovery_host",
    defaults: ["aera_host_defaults", "twrp_defaults"],
    rtti: true,
    cflags: [
        "-fno-strict-aliasing",
        "-Wno-implicit-fallthrough",
        "-Wno-unused-parameter",
        "-Wno-unused-function",
        "-Wno-unused-variable",
        "-D_USE_SYSTEM_ZIPARCHIVE",
        "-DTWRES=\"/twres/\"",
    ],
    include_dirs: [
        "bootable/recovery",
        "bootable/recovery/otautil/include",
        "bootable/recovery/install/include",
        "system/libziparchive/include",
        "bootable/recovery/recovery_ui/include",
        "bootable/recovery/fuse_sideload/include",
        "bootable/recovery/twrpinstall",
        "bootable/recovery/twrpinstall/include",
        "bootable/recovery/libpixelflinger/include",
        "bootable/recovery/minuitwrp/include",
        "bionic",
        "system/libbase/include",
        "system/core/libcutils/include",
        "system/core/include",
        "external/freetype/include",
        "external/libpng",
        "external/jsoncpp/include",
    ],
    srcs: [
        "aera_backend.cpp",
        "aera_log.cpp",
        "aera_message.cpp",
        "aera_screen_timer.cpp",
        "aera_terminal.cpp",
        "aera_ui_host.cpp",
        "aera_xml_support.cpp",
    ],
    shared_libs: [
        "libminuitwrp",
        "libft2",
        "libc",
        "libstdc++",
        "libaosprecovery",
        "libcrypto",
        "libjpeg",
        "libselinux",
        "libziparchive",
    ],
    static_libs: [
        "libaeraui",
        "liblvgl_recovery",
        "libjsoncpp",
        "libotautil",
        "libpng",
    ],
}
