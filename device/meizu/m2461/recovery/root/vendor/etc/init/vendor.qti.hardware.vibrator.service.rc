#
# Meizu 21 (m2461, SM8650) - Richtap haptic HAL for the Meizu vibration motor.
#
# The service block is declared disabled on purpose: it is started ONLY from
# init.recovery.qcom.rc's "on property:twrp.modules.loaded=true" hook (after the
# AERA module loader has inserted the Meizu haptic/GPIO modules). Do not add a
# class_start/enable here, otherwise it can start before /dev/aac_richtap_dev
# exists and crash-loop.

on late-init
    chown root root /sys/class/qcom-haptics/primitive_duration
    chmod 0600 /sys/class/qcom-haptics/primitive_duration

on boot
    chmod 0666 /dev/aac_richtap_dev
    chown root root /dev/aac_richtap_dev

service vendor.qti.vibrator /vendor/bin/hw/vendor.qti.hardware.vibrator.service
    user root
    group root input
    setenv RICHTAP_DEVICE_PATH  /dev/aac_richtap_dev
    setenv ENV_RICHTAP_CONFIG_PATH /odm/etc/aac_richtap.config
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    disabled
    seclabel u:r:recovery:s0

on property:sys.boot_completed=1
    setprop vendor.haptic.calibrate.done 1
