#
# Meizu 21 (m2461, SM8650) - ported from the verified TWRP recovery tree.
# Started from init.recovery.qcom.rc ("on init", "start vendor.boot-qti"); it
# publishes android.hardware.boot.IBootControl/default for AERA's bootctl use.
service vendor.boot-qti /vendor/bin/hw/android.hardware.boot-service.qti
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    seclabel u:r:recovery:s0
