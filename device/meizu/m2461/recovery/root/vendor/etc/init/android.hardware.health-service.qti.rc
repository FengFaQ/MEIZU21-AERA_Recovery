#
# Meizu 21 (m2461, SM8650) - ported from the verified TWRP recovery tree.
# AERA keeps the battery/health HAL that its UI polls for charge state.
#
# NOTE (deviation): vendor.charger is dropped from this port. Its declaring
# section carries seclabel u:r:charger_vendor:s0 and then overrides it with
# u:r:recovery:s0, which only works because TWRP runs a permissive domain on the
# device. AERA's charger binary (/system/bin/charger) owns the charger path and
# the recovery UI is not started in charger mode, so the entry is dead weight.
service vendor.health-default /vendor/bin/hw/android.hardware.health-service.qti_recovery
    class hal
    user root
    group root
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    seclabel u:r:recovery:s0
