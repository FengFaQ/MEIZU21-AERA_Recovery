#
# Meizu 21 (m2461, SM8650) - ported from the verified TWRP recovery tree.
# qseecomd is started explicitly from init.recovery.qcom.rc ("on fs") after the
# by-name/ssd node exists, so the service stays disabled here instead of being
# started at the "on init" stage as Qualcomm's stock file does.

service vendor.qseecomd /vendor/bin/qseecomd
    disabled
    socket notify-topology stream 660 system drmrpc
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    seclabel u:r:recovery:s0
