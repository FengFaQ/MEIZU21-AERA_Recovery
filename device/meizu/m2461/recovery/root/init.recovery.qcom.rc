# Meizu 21 (m2461, SM8650 pineapple) - AERA port.
# Ported from the verified TWRP tree's recovery/root/init.recovery.qcom.rc.
# Every change against that file is listed in the device tree's M2461_INIT.md.
# AERA installs this file as /init.recovery.${ro.hardware}.rc. The vendor overlay
# lives in the device tree at recovery/root/vendor/ and is the ramdisk's /vendor,
# so the rules below only ever spell runtime paths (/vendor/..., /odm/...).

# /etc is a symlink to /system/etc in AERA's recovery init; vendor rc files are
# imported from /vendor/etc/init by init itself, nothing to import here.
#
# init.recovery.wifi.rc lives at the ramdisk root, and init only auto-imports
# /vendor/etc/init/*.rc, so without this line the whole Wi-Fi bring-up block
# (fs_ready poke, wlan0 wait, wpa_supplicant start) is dead code. The AERA
# reference tree has the same import as its first statement.
import /init.recovery.wifi.rc

on init
    setprop prepdecrypt.setpatch true
    start vendor.boot-qti

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    # Its SSD listener opens by-name/ssd, which ueventd may not have made yet.
    wait /dev/block/bootdevice/by-name/ssd 10
    start vendor.qseecomd

    # Mount the modem partition at /firmware as early as possible.
    #
    # The kernel firmware loader resolves /firmware/image/<name>, and the modem
    # partition (modem_a = sde6) is where adsp, ipa and the WLAN board data
    # live. This used to happen only on twrp.modules.loaded, which is far too
    # late: dmesg shows adsp/ipa already failing at ~2.4 s with
    #   Direct firmware load for adsp.b01 failed with error -2
    # and cnss2 therefore never finds its WLAN firmware. Mounting it during
    # "on fs" puts /firmware in place before those drivers probe.
    mkdir /firmware 0755 root root
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro

    # The stock layout also exposes the firmware through
    # /vendor/firmware_mnt/image. In recovery /vendor is the ramdisk overlay,
    # so that path does not exist; recreate it as a link to the mounted
    # partition, which is what the TWRP tree achieved with
    # "umount /vendor; symlink /firmware /vendor/firmware_mnt".
    mkdir /vendor/firmware_mnt 0755 root root
    mount none /firmware /vendor/firmware_mnt bind rec

    # persist holds per-device calibration data, including the WLAN MAC that
    # /vendor/firmware/wlan/qca_cld/kiwi_v2/wlan_mac.bin points at. The old code
    # bound a tmpfs over /mnt/vendor/persist, which hid the real partition and
    # left the MAC unreadable. Mount the real partition instead; a failure here
    # is logged by init and does not abort the boot, which is why this is done
    # with mount rather than a fstab entry (TWRP's parser does not know every
    # flag and a bad fstab line can stop recovery from starting).
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    mount ext4 /dev/block/bootdevice/by-name/persist /mnt/vendor/persist noatime,nosuid,nodev,barrier=1
    # DEVIATION: the TWRP tree calls a private builtin here (`install_keyring`) that
    # does not exist in AERA's init (AERA-Recovery/android_system_core aera-16.0,
    # commit 245ef44, init/builtins.cpp keyword table has no such command; AERA's
    # init is plain AOSP init). Passing an unknown command to init fails the boot:
    # "Keyword: 'install_keyring' not found in /init.recovery.qcom.rc". AERA starts
    # keystore2 from its own /etc/init/keystore2.rc and pads /tmp/misc/keystore in
    # etc/init.rc, so the keyring step is dropped here. UNVERIFIED: decryption must
    # be re-tested on the device.

on boot
    setprop sys.usb.config adb

# qseecomd is up, so the HALs that reach a trustlet through it can follow.
on property:vendor.sys.listeners.registered=true
    start vendor.gatekeeper_default
    start vendor.secure_element

on property:twrp.modules.loaded=true
    # KeyMint stays down until this has pointed the version properties at the
    # installed system, so start it as early as the mapper nodes allow.
    start start_crypto_services
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/kernel/boot_adsp/ssr
    write /sys/kernel/boot_adsp/ssr 1
    wait /sys/class/power_supply/battery
    start vendor.health-default
    # vendor.qti.vibrator is declared disabled in
    # /vendor/etc/init/vendor.qti.hardware.vibrator.service.rc and is started
    # here only, after the Meizu haptic/GPIO modules requested through
    # AERA_LOAD_VENDOR_MODULES are in the kernel.
    start vendor.qti.vibrator
#    umount /vendor
#    symlink /firmware /vendor/firmware_mnt
